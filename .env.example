# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://forge_user:forge_pass@localhost:5432/forge_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production)
CORS_ORIGINS=https://yourdomain.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

GOOGLE_CLIENT_ID = Your google client id generated from the google cloud credentials
GOOGLE_CLIENT_SECRET = Your google client secret generated from the google cloud credentials
